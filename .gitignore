# Gradle
.gradle/
# Anchored to the repo root on purpose: an unanchored `build/` also matched
# src/main/java/dev/chika/builder/build/, which silently hid the whole
# build/material/shop package from version control.
/build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/
bin/

# Fabric / Loom runtime dirs
run/
remappedSrc/

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Secrets and local-only configuration - NEVER commit these.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
credentials.*
secrets.json
secrets.*
*.token
tokens.json
access_token*
local.properties
secrets.properties

# Local screenshots / scratch images at the repo root. The real assets live
# under src/main/resources/assets/.
/*.png
/*.jpg
/*.jpeg

# The internal build engine jar (baritone-meteor-26.1.jar).
#
# This is a THIRD-PARTY binary (Baritone, LGPL-3.0, authored by cabaletta/Brady)
# and is deliberately NOT committed or redistributed with this repository.
#
# To build, obtain the jar and place it in local/:
#   local/baritone-meteor-26.1.jar
#
# See README "Building from source" and architecture.md for details.
local/